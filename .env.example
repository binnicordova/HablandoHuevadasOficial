EXPO_PUBLIC_STORYBOOK_ENABLED=false

# Publish it to GITHUB Actions secrets
EAS_OWNER=your_eas_owner_here
EAS_PROJECT_ID=your_eas_project_id_here
EXPO_TOKEN=your_expo_token_here

# Voice chat (see docs/voice-chat.md)
# The voiceApi Firebase function. Local emulator, Android emulator:
#   http://10.0.2.2:5001/<project>/us-east1/voiceApi
# Deployed: https://us-east1-<project>.cloudfunctions.net/voiceApi
EXPO_PUBLIC_VOICE_API_URL=
EXPO_PUBLIC_VOICE_API_KEY=
# DeepSeek writes the replies inside the app. EXPO_PUBLIC_* values are inlined
# into the bundle: anyone with the app can read this key. Cap its spend,
# rotate it if it leaks, never commit it.
EXPO_PUBLIC_DEEPSEEK_API_KEY=
EXPO_PUBLIC_DEEPSEEK_MODEL=deepseek-chat
