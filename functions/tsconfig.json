{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2022",
        "lib": ["es2022"],
        "rootDir": "src",
        "outDir": "lib",
        "strict": true,
        "noUnusedLocals": true,
        "noImplicitReturns": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true
    },
    "include": ["src"],
    "exclude": ["src/**/__tests__"]
}
